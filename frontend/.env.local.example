# Copy to frontend/.env.local (Next.js reads env files from this folder only).
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: bypasses row-level security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Google sign-in: set to true once the Google provider is enabled in Supabase ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
# Optional: chat model (default gpt-4.1-mini)
# OPENAI_CHAT_MODEL=

# --- Pinecone: serverless index, 1024 dimensions, cosine ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_pinecone_index_name
# Optional: skips one lookup per cold start (https://<index-host>)
# PINECONE_INDEX_HOST=

# --- Stripe (test keys locally, live keys in production) ---
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRO_MONTHLY_PRICE_ID=your_stripe_pro_monthly_price_id
# Optional: offers a yearly option when set
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Monitoring: bearer token for detailed /api/health output ---
HEALTH_CHECK_TOKEN=
